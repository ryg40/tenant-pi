{
  "name": "walkr",
  "version": "0.9.3",
  "description": "Local tool for side-by-side option reviews (Compare) and fast component, decision-tree, and grilling feedback sessions (Feedback).",
  "author": "Peter Yang",
  "type": "module",
  "bin": {
    "walkr": "src/cli.js",
    "walkr-compare": "src/walkr-compare.js",
    "walkr-feedback": "src/walkr-feedback.js"
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "docs",
    "mirror",
    "install.sh",
    "INSTALL.md",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --import ./test/no-sheprd-link.js --test --test-force-exit --test-timeout=60000",
    "start": "node src/cli.js"
  },
  "keywords": [
    "compare",
    "review",
    "options",
    "agent",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "css-tree": "3.2.1",
    "jsdom": "^29.1.1"
  },
  "private": true
}
