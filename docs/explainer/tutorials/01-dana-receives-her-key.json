          {
            "t": "out",
            "text": "          ]"
          },
          {
            "t": "out",
            "text": "        }"
          },
          {
            "t": "out",
            "text": "      }"
          },
          {
            "t": "out",
            "text": "    },"
          },
          {
            "t": "out",
            "text": "    {"
          },
          {
            "t": "out",
            "text": "      \"Sid\": \"Write\","
          },
          {
            "t": "out",
            "text": "      \"Effect\": \"Allow\","
          },
          {
            "t": "out",
            "text": "      \"Action\": ["
          },
          {
            "t": "out",
            "text": "        \"bedrock-agentcore:BatchCreateMemoryRecords\""
          },
          {
            "t": "out",
            "text": "      ],"
          },
          {
            "t": "out",
            "text": "      \"Resource\": \"arn:aws:bedrock-agentcore:us-east-1:<account>:memory/<memoryId>\","
          },
          {
            "t": "out",
            "text": "      \"Condition\": {"
          },
          {
            "t": "out",
            "text": "        \"ForAllValues:StringLike\": {"
