{
  "title": "Dana receives her key",
  "who": "Dana, a new member of `example-project`",
  "goal": "Dana gets her own access key from Alice. She stores it, checks it and reads the memory once, before she uses an agent.",
  "place": "Dana's laptop. A terminal in her home directory, `/home/dana`.",
  "steps": [
    {
      "title": "Alice prepares Dana's access",
      "before": [
        "Alice adds Dana to her private registry: one person entry and one member entry in `example-project`.",
        "Then she runs the registry script. A dry run is the default: the script prints the plan and changes nothing."
      ],
      "frame": {
        "kind": "shell",
        "title": "alice@desk: ~/tenant-pi",
