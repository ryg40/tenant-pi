        "live": false,
        "lines": [
          {
            "t": "cmd",
            "prompt": "alice@desk:~/tenant-pi$",
            "text": "node packages/agentcore-memory-admin/bin/registry.mjs render --registry ~/.config/agentcore-memory-admin/registry.json --person dana"
          },
          {
            "t": "out",
            "text": "person: dana (Dana Dunn)"
          },
          {
            "t": "out",
            "text": "iam user: pi-memory-person-dana"
          },
          {
            "t": "out",
            "text": "inline policy: agentcore-memory"
          },
          {
            "t": "out",
            "text": "policy characters without white space: 746 of 2048"
          },
          {
            "t": "out",
            "text": "policy:"
          },
          {
            "t": "out",
            "text": "{"
          },
