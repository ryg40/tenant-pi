# Template of <private dir>/seat.env, the file that the operator gives to Compose with --env-file.
# Compose reads these variables when it reads the Compose file. They are not secrets.
# The container does not get this file. The gateway key is in compose.env, not here.
# KIT_COMMIT is not in this file, because it changes with the checkout. Give it in the command:
#   KIT_COMMIT=$(git rev-parse --short HEAD) docker compose --env-file <private dir>/seat.env ...

# Mandatory. The absolute path of the private directory. It holds overlay.json, authorized_keys and compose.env.
SEAT_PRIVATE_DIR=
# The account name of the seat. Lowercase letters, digits, "_" and "-".
SEAT_USER=pi
# The UID of the account. Use the UID of the operator (id -u).
SEAT_UID=1000
# The GID of the account. Use the GID of the operator (id -g).
SEAT_GID=1000
# The address on the machine that receives the SSH connections. 0.0.0.0 opens the seat to the network.
SEAT_BIND=127.0.0.1
# The port on the machine that receives the SSH connections.
SEAT_SSH_PORT=2222
# Empty for Docker. For Podman: keep-id:uid=<SEAT_UID>,gid=<SEAT_GID>
SEAT_USERNS=
# The name of the variable in compose.env that holds the gateway key.
SEAT_KEY_VAR=TENANTEXT_LITELLM_API_KEY
# Optional. The absolute path of the projects directory. Compose reads it only with compose.projects.yaml.
#SEAT_PROJECTS_DIR=
