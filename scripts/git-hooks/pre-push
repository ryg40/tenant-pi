#!/bin/sh
# pre-push: scan the commits that the push sends with scripts/scan.sh.
# Install with scripts/install-hooks.sh. See docs/secret-handling.md.
#
# A secret or a policy finding refuses the push. A host value refuses a push
# of the branch portable or of a tag portable/*, and a push to a remote ref
# with such a name; for other refs it prints a warning. The level does not
# change the range: also for a portable ref the scan covers the commits that
# the remote does not have.
# scripts/publish_portable.py pushes the local branch portable to the remote
# branch main, so the local ref and the remote ref both set the level.

set -eu

remote=$1
top=$(git rev-parse --show-toplevel)
scan=$top/scripts/scan.sh
if [ ! -f "$scan" ]; then
    # Fail closed: the script is gone from the working tree, but the branch has it.
    if git cat-file -e :scripts/scan.sh 2>/dev/null || git cat-file -e HEAD:scripts/scan.sh 2>/dev/null; then
        echo "pre-push: scripts/scan.sh is not in the working tree, but it is in the index or in HEAD; push refused" >&2
        exit 1
    fi
    echo "pre-push: scripts/scan.sh is not on this branch (not in the working tree, the index or HEAD); no scan" >&2
    exit 0
fi

status=0
# Git writes one line for each ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    case $local_sha in *[!0]*) ;; *) continue ;; esac # a delete sends no commit
    if case $remote_sha in *[!0]*) false ;; *) true ;; esac ||
        ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # A new ref, or the remote commit is not here: the commits that no
        # remote-tracking ref of this remote contains. Git gives the hook no
        # list of the remote commits, so the range is as current as the last
        # fetch or push. With no remote-tracking ref of this remote (a new
        # remote, or a push to a URL), the range is all of the history of the
        # ref. A URL can hold a blank, so it must not go into the range.
        if [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote/")" ]; then
            range="$local_sha --not --remotes=$remote"
        else
            range=$local_sha
            case "$local_ref $remote_ref" in
                refs/heads/portable\ *|*\ refs/heads/portable|*refs/tags/portable/*)
                    # A first publication of a portable ref must be clean in all of its history.
                    echo "pre-push: no remote-tracking ref of $remote; scan all of the history of $local_ref" >&2 ;;
            esac
        fi
    else
        range="$remote_sha..$local_sha"
    fi
    echo "pre-push: scan $local_ref -> $remote_ref" >&2
    SCAN_REF="$local_ref $remote_ref" sh "$scan" history "$range" </dev/null || status=1
done

[ "$status" -eq 0 ] || echo "pre-push: push refused (docs/secret-handling.md)" >&2
exit "$status"
