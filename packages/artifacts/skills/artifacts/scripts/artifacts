#!/usr/bin/env python3
"""artifacts: store an HTML or Markdown file in the local artifact store and print its view link.

Commands: setup, upload, list, open, delete, doctor, retention, and start, off (alias stop), status and walkr-url for
the one local server of this user. An upload writes into the store directly and needs no running server. The server is the
read-only program `server/artifacts_server.py` of this package; it listens on 127.0.0.1 only and has the root page /,
the index /artifacts and the Walkr page /walkr. off stops only this server, never a Walkr process. With the key `remote`
(artifacts setup --remote HOST), upload, list, delete and open work on the store of HOST over SSH; --here ignores
the key for one call.

Exit codes: 0 done, 2 refused input (walkr-url: the session is unknown or the ID is not valid), 3 the server or the
remote store did not start or answer, 4 walkr-url: Walkr or Node is absent, 5 the scan stopped the upload.
"""
import argparse
import fcntl
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.parse

# The package root from the real path of this file, so the ~/.local/bin and ~/.claude/skills links work.
PACKAGE = Path(os.path.realpath(__file__)).parents[3]
SERVER = PACKAGE / 'server' / 'artifacts_server.py'
sys.dont_write_bytecode = True
sys.path.insert(0, str(SERVER.parent))
import artifacts_store as store_lib  # noqa: E402
import walkr_front  # noqa: E402

TYPES = {'.html': 'text/html', '.htm': 'text/html', '.md': 'text/markdown', '.markdown': 'text/markdown'}
SCAN_TIMEOUT = 300
GIT_TIMEOUT = 10
HEALTH_WAIT = 30
STOP_WAIT = 10
HEALTH_TIMEOUT = 2
# walkr-url stops `walkr-compare open` after this time. Walkr itself gives up its start after about 6 s, and a slow
# request after 10 s.
WALKR_URL_WAIT = 20
# The page address that `walkr-compare open` prints: the path holds the page secret, the fragment a session ID.
WALKR_PAGE = re.compile(r'/_walkr/compare/g/[a-f0-9]{64}')
WALKR_SESSION = re.compile(r'[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}')
# A test seam, not a setting: a command line (shlex form) that scans the files of its working directory.
SCAN_ENV = 'ARTIFACTS_SCAN_COMMAND'
# A test seam, not a setting: a command line (shlex form) that replaces the program ssh of the remote store.
SSH_ENV = 'ARTIFACTS_SSH_COMMAND'
SSH_OPTIONS = ('-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-T', '-a', '-x')
# An upload waits for the scan of the remote computer too.
REMOTE_UPLOAD_TIMEOUT = SCAN_TIMEOUT + 60
REMOTE_TIMEOUT = 30
REMOTE_DOCTOR_TIMEOUT = 15
REMOTE_MISSING = 127
# The remote shell gives the words of a call to this script as "$@": the artifacts program of the remote PATH, else
# ~/.local/bin/artifacts, else exit 127. Without HERDR_ENV, a remote open starts no Sheprd.
REMOTE_SCRIPT = ('unset HERDR_ENV; '
                 'if command -v artifacts >/dev/null 2>&1; then exec artifacts "$@"; fi; '
                 'if [ -x "$HOME/.local/bin/artifacts" ]; then exec "$HOME/.local/bin/artifacts" "$@"; fi; '
                 'exit 127')
# The commands that go to the remote store when the key `remote` is set and --here is not given.
REMOTE_COMMANDS = ('upload', 'list', 'delete', 'open')


class Stop(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def config():
    try:
        return store_lib.load_config()
    except store_lib.ConfigError as error:
        raise Stop(2, str(error)) from None


def port_of(data):
    try:
        return store_lib.port_of(data)
    except store_lib.ConfigError as error:
        raise Stop(2, str(error)) from None


def retention_of(data):
    try:
        return store_lib.retention_of(data)
    except store_lib.ConfigError as error:
        raise Stop(2, str(error)) from None


def remote_of(data):
    try:
        return store_lib.remote_of(data)
    except store_lib.ConfigError as error:
        raise Stop(2, str(error)) from None


def index_url(port):
    """The root page: the links to /artifacts and /walkr."""
    return f'http://127.0.0.1:{port}/'


def artifacts_url(port):
    """The index of the stored artifacts."""
    return f'http://127.0.0.1:{port}/artifacts'


def walkr_page_url(port):
    """The Walkr information page of the server. It holds no secret and is not the private Walkr address."""
    return f'http://127.0.0.1:{port}/walkr'


def view_url(port, slug):
    """The viewer page of one artifact: a bar with the facts and the links, and the artifact in a frame."""
    return f'http://127.0.0.1:{port}/v/{slug}'


def plain(value, limit=200):
    """One line of text: control characters become spaces, so the tab-separated list stays one line each."""
    return re.sub(r'[\x00-\x1f\x7f]+', ' ', str(value)).strip()[:limit]


# ---------------------------------------------------------------------------
# The secret scan
# ---------------------------------------------------------------------------
def kit_scanner():
    """`<kit>/scripts/scan.sh --level warn tree` when the CLI runs from a kit tree, else None."""
    kit = PACKAGE.parents[1]
    scan = kit / 'scripts' / 'scan.sh'
    if scan.is_file() and (kit / 'config' / 'manifest.json').is_file():
        return ['sh', str(scan), '--level', 'warn', 'tree']
    return None


def find_scanner(quiet=False):
    line = os.environ.get(SCAN_ENV)
    if line:
        if not quiet:
            print(f'warning: {SCAN_ENV} is set (a test seam); the kit scanner does not run', file=sys.stderr)
        return shlex.split(line)
    return kit_scanner()


def scan(command, name, raw):
    """Run the scanner on the bytes `raw` as the file `name` in a new scratch Git repository.

    The scanner gets the same bytes as the store, not a new read of the file. A finding or an error is a Stop."""
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env['GIT_CONFIG_NOSYSTEM'] = '1'
    work = tempfile.mkdtemp(prefix='artifacts-scan-')
    try:
        fd = os.open(os.path.join(work, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(raw)
        try:
            subprocess.run(['git', 'init', '-q', work], env=env, check=True, capture_output=True, timeout=60)
            subprocess.run(['git', '-C', work, 'add', '--', name], env=env, check=True, capture_output=True,
                           timeout=60)
            done = subprocess.run(command, cwd=work, env=env, capture_output=True, text=True, timeout=SCAN_TIMEOUT)
        except (OSError, subprocess.SubprocessError) as error:
            raise Stop(5, f'scan: the scanner did not run ({type(error).__name__}); nothing uploaded') from None
        if done.returncode:
            report = (done.stdout + done.stderr).strip()
            if report:
                print(report, file=sys.stderr)
            # scripts/scan.sh: exit 1 is a finding; exit 2 is a usage or tool error, for example no Betterleaks binary.
            if done.returncode == 1:
                raise Stop(5, 'scan: the scanner reported a finding; nothing uploaded')
            raise Stop(5, f'scan: the scanner could not run (exit {done.returncode}); nothing uploaded')
    finally:
        shutil.rmtree(work, ignore_errors=True)


def scan_upload(name, raw):
    """The scan of an upload on this computer: a finding or a scanner that does not run is a Stop."""
    command = find_scanner()
    if command is None:
        print('warning: no secret scanner (the CLI runs outside a kit tree); the file is not scanned', file=sys.stderr)
    else:
        scan(command, name, raw)


# ---------------------------------------------------------------------------
# The remote store
# ---------------------------------------------------------------------------
def ssh_program():
    line = os.environ.get(SSH_ENV)
    if line:
        print(f'warning: {SSH_ENV} is set (a test seam); the program ssh does not run', file=sys.stderr)
        return shlex.split(line)
    return ['ssh']


def remote_command(words):
    """The command line for the remote shell. Each word is quoted with shlex.quote and joined here, so the remote
    shell gives each word to sh as it is: a title such as $(id) stays text."""
    return ' '.join(shlex.quote(word) for word in ('sh', '-c', REMOTE_SCRIPT, 'artifacts', '--here', *words))


def remote_call(host, words, data=b'', timeout=REMOTE_TIMEOUT, lost='nothing is changed'):
    """Run `artifacts --here WORDS` on the computer `host` with one ssh call, `data` on its standard input, and
    return the CompletedProcess (bytes). No connection, no remote artifacts program, a timeout or an ssh program
    that a signal ended is a Stop with exit 3; `lost` says what did not happen. A connection can end after the
    remote command finished: the message says so where that is possible."""
    command = [*ssh_program(), *SSH_OPTIONS, '--', host, remote_command(words)]
    late = (f', unless the connection ended after {host} finished the command (artifacts list shows the store of '
            f'{host})')
    try:
        done = subprocess.run(command, input=data, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        why = f'no answer from {host} in {timeout} s; the call is stopped; {lost}{late}'
    except OSError as error:
        why = f'the ssh program did not run ({type(error).__name__}); {lost}'
    else:
        if done.returncode == 255:
            why = f'ssh lost or did not get the connection to {host} (exit 255); {lost}{late}'
        elif done.returncode < 0:
            why = f'a signal ended the ssh program (signal {-done.returncode}); {lost}{late}'
        elif done.returncode == REMOTE_MISSING:
            why = f'{host} has no artifacts program on its PATH or in ~/.local/bin; {lost}'
        else:
            return done
        sys.stderr.buffer.write(done.stderr)
        sys.stderr.buffer.flush()
    raise Stop(3, f'{why}. To use the store of this computer, run artifacts setup --local, or artifacts --here '
                  '<command> for one call')


def relay(done):
    """Write the remote standard output and standard error here, and return the remote exit code."""
    for mine, theirs in ((sys.stdout, done.stdout), (sys.stderr, done.stderr)):
        mine.flush()
        mine.buffer.write(theirs)
        mine.buffer.flush()
    return done.returncode


# ---------------------------------------------------------------------------
# The repo of an upload
# ---------------------------------------------------------------------------
class GitTimeout(Exception):
    pass


def git(*args):
    """The output of one git command in the working directory, or None on each failure but a timeout."""
    try:
        done = subprocess.run(['git', *args], capture_output=True, text=True, timeout=GIT_TIMEOUT,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise GitTimeout() from None
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout.strip() if done.returncode == 0 and done.stdout.strip() else None


def remote_name(url):
    """The last path part of a remote URL without `.git`, or None. The user and host part is never used."""
    if '://' in url:
        path = url.split('://', 1)[1].partition('/')[2]
    elif re.match(r'[^/]*:', url):
        path = url.split(':', 1)[1]  # scp form user@host:path
    else:
        path = url
    name = path.rstrip('/').rsplit('/', 1)[-1]
    name = name[:-4] if name.endswith('.git') else name
    return name if re.fullmatch(r'[A-Za-z0-9._ -]{1,100}', name) and name not in ('.', '..') else None


def detect_repo():
    """The repo name: the name of the `origin` remote, else the directory of the main checkout, else None.

    A git that does not answer in time gives None at once, with no further git command."""
    try:
        return repo_name()
    except GitTimeout:
        return None


def repo_name():
    url = git('remote', 'get-url', 'origin')
    name = remote_name(url) if url else None
    if name:
        return name
    common = git('rev-parse', '--path-format=absolute', '--git-common-dir') or git('rev-parse', '--git-common-dir')
    if not common:
        return None
    name = Path(os.path.abspath(common)).resolve().parent.name
    return plain(name, 100) or None


# ---------------------------------------------------------------------------
# The server: health, state, lock
# ---------------------------------------------------------------------------
def healthz(port, timeout=HEALTH_TIMEOUT):
    """The JSON value of a 200 answer to GET /healthz on 127.0.0.1:port, or None."""
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=timeout)
    try:
        connection.request('GET', '/healthz')
        reply = connection.getresponse()
        return json.loads(reply.read(4096).decode('utf-8')) if reply.status == 200 else None
    except (OSError, http.client.HTTPException, ValueError, UnicodeDecodeError):
        return None
    finally:
        connection.close()


def earlier_server(port):
    """Advice when the program on the port answers /healthz as the server of an earlier kit version did, else ''.

    That server (`node server.mjs`) sent {"status": "ok"} with no `service` key. The CLI sends it no signal."""
    data = healthz(port)
    if not (isinstance(data, dict) and data.get('status') == 'ok' and 'service' not in data):
        return ''
    return ('the program on the port is probably the artifact server of an earlier kit version. To stop it, find '
            f"the process that listens on the port with ss -ltnp 'sport = :{port}' (Linux) or "
            f'lsof -nP -iTCP:{port} -sTCP:LISTEN (macOS), then end it with kill <PID>')


def health(port, timeout=HEALTH_TIMEOUT):
    """The /healthz answer of the tenant-artifacts server of this user on 127.0.0.1:port as a dict, or None.

    A server of another user ID, or one that sends no user ID, is another program on the port."""
    data = healthz(port, timeout)
    if (isinstance(data, dict) and data.get('service') == store_lib.SERVICE and valid_pid(data.get('pid'))
            and type(data.get('uid')) is int and data['uid'] == os.getuid()):
        return data
    return None


def valid_pid(value):
    """A PID that a signal can name alone: 0 and -1 would reach a process group or each process."""
    return type(value) is int and value > 1


def state_file():
    return store_lib.state_dir() / 'server.json'


def read_state():
    try:
        data = json.loads(state_file().read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) and valid_pid(data.get('pid')) else {}


def write_state(data):
    fd, scratch = tempfile.mkstemp(dir=store_lib.state_dir(), prefix='.server-')
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        handle.write(json.dumps(data) + '\n')
    os.replace(scratch, state_file())


def lock():
    """An exclusive lock of the state directory for one start or off; it ends with the process."""
    store_lib.state_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = open(store_lib.state_dir() / 'lock', 'a')
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def port_free(port):
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.settimeout(1)
        if probe.connect_ex(('127.0.0.1', port)) == 0:
            return False
    finally:
        probe.close()
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # as the server does; a TIME_WAIT port is free
        probe.bind(('127.0.0.1', port))
        return True
    except OSError:
        return False
    finally:
        probe.close()


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def log_tail(log, count=20):
    try:
        return '\n'.join(log.read_text(encoding='utf-8', errors='replace').splitlines()[-count:])
    except OSError:
        return ''


# ---------------------------------------------------------------------------
# The commands
# ---------------------------------------------------------------------------
def cmd_setup(args):
    data = config()
    if args.remote is not None and not store_lib.valid_remote(args.remote):
        raise Stop(2, store_lib.REMOTE_RULE + '; nothing written')
    try:
        old = store_lib.port_of(data)
    except store_lib.ConfigError:
        old = None  # setup --port N repairs a port that is not valid
    port = args.port if args.port is not None else old or store_lib.DEFAULT_PORT
    if not 1 <= port <= 65535:
        raise Stop(2, 'the port is a number from 1 to 65535')
    # A server of this home on the old port would stay out of reach of off, which asks the configured port. The
    # state file tells it from a server that the same user started from another home.
    answer = health(old) if old and port != old else None
    if answer and answer['pid'] == read_state().get('pid'):
        raise Stop(2, f'the server runs on port {old}: run artifacts off first, then setup, then start')
    data['port'] = port
    if args.remote is not None:
        data['remote'] = args.remote
    elif args.local:
        data.pop('remote', None)
    store_lib.write_config(data)
    print('config: ' + str(store_lib.config_path()))
    print(f'port: {port}')
    if args.remote is not None or args.local:
        print('remote: ' + data.get('remote', 'none (the store of this computer)'))
    return 0


def read_upload(args):
    """The path, the content type and the bytes of an upload: the file, or with `-` standard input as the last path
    part of --name."""
    if args.file == '-':
        if args.name is None:
            raise Stop(2, 'upload - reads the file from standard input and needs --name FILENAME')
        path = Path(Path(args.name).name)
    elif args.name is not None or args.size is not None or args.sha256 is not None:
        raise Stop(2, '--name, --size and --sha256 go only with upload -, the file from standard input')
    else:
        path = Path(args.file)
    kind = TYPES.get(path.suffix.lower())
    if kind is None:
        raise Stop(2, 'the file must end in .html, .htm, .md or .markdown')
    try:
        raw = sys.stdin.buffer.read(store_lib.MAX_BYTES + 1) if args.file == '-' else path.read_bytes()
    except OSError as error:
        raise Stop(2, f'cannot read {"standard input" if args.file == "-" else path}: {error.strerror}') from None
    # A sender announces the size and the hash: a stream that a lost connection cut is not the file.
    if ((args.size is not None and len(raw) != args.size)
            or (args.sha256 is not None and hashlib.sha256(raw).hexdigest() != args.sha256.lower())):
        raise Stop(2, 'standard input is not the announced file (--size, --sha256): the stream was cut or changed; '
                      'nothing stored')
    if len(raw) > store_lib.MAX_BYTES:
        raise Stop(2, 'the file is larger than 10 MiB')
    try:
        raw.decode('utf-8')
    except UnicodeDecodeError:
        raise Stop(2, 'the file is not UTF-8 text') from None
    return path, kind, raw


def upload_remote(args, path, raw):
    """Scan here, then send the bytes on the standard input of one ssh call to `artifacts --here upload -` of the
    remote store. Nothing is stored on this computer."""
    if args.replace is not None and not store_lib.SLUG.fullmatch(args.replace):
        raise Stop(2, f'no artifact {plain(args.replace, 40)} in the store; nothing replaced')
    scan_upload(path.name, raw)
    # The `--x=VALUE` form, so a value that starts with `-` stays a value.
    words = ['upload', '-', '--name=' + path.name, '--size=' + str(len(raw)),
             '--sha256=' + hashlib.sha256(raw).hexdigest()]
    if args.title is not None:
        words.append('--title=' + args.title)
    if args.replace is not None:
        words.append('--replace=' + args.replace)
        if args.repo is not None:
            words.append('--repo=' + args.repo)
    else:
        # The working directory is here: an empty value is no repo, so the remote side detects none of its own.
        words.append('--repo=' + (args.repo if args.repo is not None else detect_repo() or ''))
    code = relay(remote_call(args.host, words, raw, REMOTE_UPLOAD_TIMEOUT, 'the file is not stored'))
    if code == 0:
        print('on: ' + args.host)
    return code


def cmd_upload(args):
    data = config()
    if args.host:
        path, _, raw = read_upload(args)
        return upload_remote(args, path, raw)
    port, days = port_of(data), retention_of(data)
    path, kind, raw = read_upload(args)
    store = store_lib.store_dir()
    unknown = Stop(2, f'no artifact {plain(args.replace or "", 40)} in the store; nothing replaced')
    # An unknown slug is refused before the scan; the store changes only after a clean scan.
    if args.replace is not None and store_lib.artifact_meta(store, args.replace) is None:
        raise unknown
    scan_upload(path.name, raw)
    repo = (plain(args.repo, 100) or None) if args.repo is not None else None
    if args.replace is not None:
        # The title and the repo stay unless the options give new ones.
        title = (plain(args.title) or path.name) if args.title else None
        try:
            meta = store_lib.replace_artifact(store, args.replace, raw, plain(path.name), kind, title, repo,
                                              keep_repo=args.repo is None)
        except store_lib.NotAnArtifact:
            raise unknown from None
        except OSError as error:
            raise Stop(2, f'cannot replace {args.replace}: {error.strerror or type(error).__name__}') from None
    else:
        title = plain(args.title or path.stem) or path.name
        if args.repo is None:
            repo = detect_repo()
        meta = store_lib.add_artifact(store, raw, plain(path.name), kind, title, repo)
    print('slug: ' + meta['slug'])
    print('view: ' + view_url(port, meta['slug']))
    print('expires: ' + store_lib.expiry(meta, days))
    if not health(port):
        # A sender relays this note: for a file from standard input it names the computer that holds the store.
        where = ' of the receiving computer; run artifacts start there' if args.file == '-' else '; run artifacts start'
        print('note: no artifacts server runs on port ' + str(port) + where + ' to view it', file=sys.stderr)
    return 0


def cmd_list(args):
    if args.host:
        return relay(remote_call(args.host, ['list']))
    days = retention_of(config())
    for meta in store_lib.artifacts(store_lib.store_dir()):
        print('\t'.join((meta['slug'], plain(meta.get('title') or ''), store_lib.expiry(meta, days))))
    return 0


def sheprd_command():
    """The Sheprd command: `sheprd` on PATH, then ~/.local/bin/sheprd, then the old path of an old install; else None."""
    found = shutil.which('sheprd')
    if found:
        return found
    for path in (Path.home() / '.local/bin/sheprd', Path.home() / '.local/state/herdr/gpui/bin/herdr-gpui'):
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return None


def cmd_delete(args):
    """Delete the named artifacts. Each slug is checked first; one that names no artifact deletes nothing. A scratch
    directory that could not be removed stays: the command names it and exits 2. With a remote store, each slug is
    checked here against the slug pattern first."""
    if args.host:
        for slug in args.slugs:
            if not store_lib.SLUG.fullmatch(slug):
                raise Stop(2, f'{plain(slug, 40)} is not a slug (32 characters of A-Z, a-z, 0-9, _ and -); '
                              'nothing deleted')
        return relay(remote_call(args.host, ['delete', '--', *args.slugs], lost='nothing is deleted'))
    left = []

    def deleted(slug, scratch):
        print('deleted: ' + slug)
        if scratch:
            left.append(scratch)
            print(f'artifacts: the artifact is out of the store, but its scratch directory {scratch} could not be '
                  'removed; remove it by hand', file=sys.stderr)
    try:
        store_lib.delete_artifacts(store_lib.store_dir(), args.slugs, deleted)
    except store_lib.NotAnArtifact as error:
        raise Stop(2, f'no artifact {plain(error.args[0], 40)} in the store; nothing deleted') from None
    except OSError as error:
        raise Stop(2, f'a delete failed ({error.strerror or type(error).__name__}); '
                      'artifacts list shows what is left') from None
    return 2 if left else 0


def cmd_open(args):
    if args.slug is not None and not store_lib.SLUG.fullmatch(args.slug):
        raise Stop(2, 'a slug is 32 characters of A-Z, a-z, 0-9, _ and -')
    if args.host:
        # The remote open prints the URL and starts no browser. The Sheprd command of this computer is not run: on
        # an SSH host it forwards the port of this computer, which is the wrong server.
        code = relay(remote_call(args.host, ['open', *(['--', args.slug] if args.slug else [])]))
        if code == 0:
            print(f'note: the address is valid on {args.host}, not on this computer', file=sys.stderr)
        return code
    port = port_of(config())
    url = view_url(port, args.slug) if args.slug else artifacts_url(port)
    print(url)
    sheprd = sheprd_command() if os.environ.get('HERDR_ENV') == '1' else None
    if sheprd:
        try:
            done = subprocess.run([sheprd, 'browser', 'open', url], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            print('warning: Sheprd did not open the page (' + type(error).__name__ + ')', file=sys.stderr)
            return 0
        if done.returncode:
            print('warning: Sheprd did not open the page (exit ' + str(done.returncode) + ')', file=sys.stderr)
    return 0


def cmd_retention(args):
    data = config()
    if args.value is None:
        days = retention_of(data)
        print('retention: ' + ('none' if days is None else f'{days} days'))
        return 0
    if args.value == 'none':
        data.pop('retentionDays', None)
        store_lib.write_config(data)
        print('retention: none (the server deletes no artifact)')
        return 0
    if not re.fullmatch(r'[0-9]{1,4}', args.value) or not 1 <= int(args.value) <= store_lib.RETENTION_MAX:
        raise Stop(2, f'retention is a number of days from 1 to {store_lib.RETENTION_MAX}, or none')
    days = int(args.value)
    data['retentionDays'] = days
    store_lib.write_config(data)
    older = len(store_lib.expired(store_lib.store_dir(), days, store_lib.now_utc()))
    print(f'retention: {days} days')
    print(f'older than {days} days now: {older} artifact' + ('' if older == 1 else 's')
          + ' (a running server deletes them at its next sweep, within one hour)')
    return 0


def scanner_text():
    if os.environ.get(SCAN_ENV):
        return f'the command of {SCAN_ENV} (a test seam)'
    command = kit_scanner()
    if command is None:
        return 'none: the CLI runs outside a kit tree, so an upload is not scanned'
    return ' '.join(command[1:])


def remote_reply(host):
    """One short ssh call: `answers ...` when `artifacts --here --json status` of the remote store answers, else
    the reason."""
    try:
        done = remote_call(host, ['--json', 'status'], timeout=REMOTE_DOCTOR_TIMEOUT)
    except Stop as error:
        return 'no answer: ' + str(error)
    try:
        answer = json.loads(done.stdout.decode('utf-8'))
        state, url = answer['state'], answer['url']
    except (UnicodeDecodeError, ValueError, TypeError, KeyError):
        answer = None
    if done.returncode or not isinstance(answer, dict):
        return f'no answer: artifacts --json status on {host} gave exit {done.returncode} and no status'
    return f'answers (server {plain(state, 20)}, {plain(url, 100)})'


def cmd_doctor(args):
    good = True
    try:
        data = store_lib.load_config()
        port = store_lib.port_of(data)
        days = store_lib.retention_of(data)
        remote = None if args.here else store_lib.remote_of(data)
    except store_lib.ConfigError as error:
        print('config: ' + str(error))
        print('doctor: FAIL')
        return 3
    print('config: ' + str(store_lib.config_path()) + ('' if store_lib.config_path().is_file() else ' (absent: defaults)'))
    store = store_lib.store_dir()
    if store.exists() and not (store.is_dir() and os.access(store, os.R_OK | os.W_OK | os.X_OK)):
        print(f'store: {store} (not a readable and writable directory)')
        good = False
    else:
        print(f'store: {store} ({len(store_lib.artifacts(store))} artifacts)')
    answer, hint = health(port), ''
    if answer:
        server = f'running (pid {answer["pid"]})'
    elif port_free(port):
        server = 'stopped'
    else:
        server = 'stopped; the port is in use by another program (artifacts setup --port N)'
        good = False
        hint = earlier_server(port)
    print(f'port: {port}')
    print('server: ' + server)
    if hint:
        print('note: ' + hint)
    print('retention: ' + ('none' if days is None else f'{days} days'))
    print('scanner: ' + scanner_text())
    # Information only: Walkr does not change the result.
    if walkr_front.installed():
        print('walkr: installed, live server ' + walkr_front.socket_state())
    else:
        print('walkr: not installed (no program walkr-compare on the PATH)')
    if remote:
        print('remote: ' + remote)
        reply = remote_reply(remote)
        good = good and reply.startswith('answers')
        print('remote store: ' + reply)
    unused = [key for key in store_lib.OLD_KEYS if key in data]
    if unused:
        print('unused config keys (kept, ignored): ' + ', '.join(unused))
    print('doctor: ' + ('PASS' if good else 'FAIL'))
    return 0 if good else 3


def server_env():
    """A small environment for the server: PATH, HOME and the XDG variables that are set."""
    return {name: value for name, value in os.environ.items()
            if name in ('PATH', 'HOME') or name.startswith('XDG_')}


def stop_child(process):
    """Stop a server that this start began. Signal only through the Popen object, and only while the child is not
    reaped: after poll() reaps it, its PID can belong to another program."""
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=STOP_WAIT)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def dump_stack(process):
    """Ask a server that gives no /healthz answer to write the stack of each thread to its log (SIGUSR1)."""
    if process.poll() is None:
        process.send_signal(signal.SIGUSR1)
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass


def facts(port, answer):
    """The pages, the modules and the Walkr socket of the server on `port`: from its /healthz answer when it runs,
    else from walkr_front with the rule of the server. Each address is built from the configured port. No value of
    the Walkr record goes in: `socket` is the word open or closed.

    A server from before the root page (its answer has no `schema`) has no /artifacts and no /walkr, so `url` and
    pages.artifacts are the root address, and `old` is True."""
    root = index_url(port)
    if answer and 'schema' not in answer:
        return {'url': root, 'pages': {'root': root, 'artifacts': root}, 'modules': ['artifacts'], 'socket': None,
                'old': True}
    if answer:
        listed = answer.get('pages') if isinstance(answer.get('pages'), dict) else {}
        walkr = 'walkr' in listed and isinstance(answer.get('walkr'), dict)
        socket_word = answer['walkr'].get('socket') if walkr else None
        if socket_word not in ('open', 'closed'):
            walkr, socket_word = False, None
    else:
        walkr = walkr_front.installed()
        socket_word = walkr_front.socket_state() if walkr else None
    pages = {'root': root, 'artifacts': artifacts_url(port)}
    if walkr:
        pages['walkr'] = walkr_page_url(port)
    return {'url': pages['artifacts'], 'pages': pages, 'modules': ['artifacts', 'walkr'] if walkr else ['artifacts'],
            'socket': socket_word, 'old': False}


OLD_SERVER_NOTE = ('note: this server runs from before the update and has no /artifacts page; '
                   'artifacts off and artifacts start give the new pages')


def page_lines(known):
    """The lines `root:` and, with Walkr, `walkr:` of start, and the note for a server from before the update."""
    lines = ['root: ' + known['pages']['root']]
    if 'walkr' in known['pages']:
        lines.append('walkr: ' + known['pages']['walkr'])
    if known['old']:
        lines.append(OLD_SERVER_NOTE)
    return lines


def cmd_start(args):
    port = port_of(config())
    with lock():
        answer = health(port)
        if answer:
            known = facts(port, answer)
            print(f'a server runs already (pid {answer["pid"]}); start starts no second one')
            print('\n'.join(page_lines(known)))
            print(known['url'])
            return 0
        if not port_free(port):
            hint = earlier_server(port)
            raise Stop(2, f'port {port} is in use by another program; choose another with artifacts setup --port N'
                       + ('\nartifacts: ' + hint if hint else ''))
        if not SERVER.is_file():
            raise Stop(3, f'the server program {SERVER} is missing')
        log = store_lib.state_dir() / 'server.log'
        fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as out:
            process = subprocess.Popen([sys.executable, '-B', str(SERVER), '--port', str(port)],
                                       cwd=str(store_lib.state_dir()), env=server_env(), stdin=subprocess.DEVNULL,
                                       stdout=out, stderr=out, start_new_session=True)
        try:
            # The state file comes before the health wait: when this command ends early, off can still stop the
            # server.
            write_state({'pid': process.pid, 'port': port, 'startedAt': store_lib.iso(store_lib.now_utc())})
            deadline = time.monotonic() + HEALTH_WAIT
            while True:
                answer = health(port)
                if answer and answer['pid'] == process.pid:
                    break
                ended = process.poll() is not None
                if ended or time.monotonic() > deadline:
                    if not ended:
                        dump_stack(process)
                    stop_child(process)
                    tail = log_tail(log)
                    if tail:
                        print(tail, file=sys.stderr)
                    why = 'the server ended before a /healthz answer' if ended else \
                        f'the server gave no /healthz answer in {HEALTH_WAIT} s; it is stopped'
                    raise Stop(3, f'{why}. Log: {log}')
                time.sleep(0.1)
        except BaseException:
            # Each failure path of start stops the new server and removes its state file.
            stop_child(process)
            state_file().unlink(missing_ok=True)
            raise
        known = facts(port, answer)
        print(f'started: pid {process.pid}, log {log}')
        print('\n'.join(page_lines(known)))
        print(known['url'])
        return 0


def cmd_off(args):
    port = port_of(config())
    with lock():
        state = read_state()
        answer = health(port)
        stopped = left = 0
        # Signal only the PID that both the state file and the /healthz answer name. No process list scan.
        if state and answer and answer['pid'] == state['pid']:
            pid = state['pid']
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            deadline = time.monotonic() + STOP_WAIT
            while time.monotonic() < deadline and (health(port, timeout=1) or {}).get('pid') == pid:
                time.sleep(0.1)
            if (health(port, timeout=1) or {}).get('pid') == pid:
                print(f'pid {pid} did not stop in {STOP_WAIT} s', file=sys.stderr)
                left = 1
            else:
                stopped = 1
        elif answer:
            print(f'the server on port {port} (pid {answer["pid"]}) is not the one of the state file; '
                  'no signal sent', file=sys.stderr)
        # The state file goes when its server stopped or its PID is gone; else a later off can still use it.
        if state and not left and (stopped or not alive(state['pid'])):
            state_file().unlink(missing_ok=True)
        # off never signals a Walkr process: a review that an agent waits on goes on.
        if walkr_front.socket_state() == 'open':
            print('walkr: a live Walkr server still runs; off does not stop it')
        print(f'off: stopped {stopped} local server' + ('' if stopped == 1 else 's'))
        return 3 if left else 0


def cmd_status(args):
    data = config()
    port = port_of(data)
    # status keeps its JSON and exit 0 with a bad remote value; that value is not shown.
    value = data.get('remote')
    remote = value if store_lib.valid_remote(value) else None
    answer = health(port)
    # Sheprd parses the two state words; another word is a parse error there.
    state = 'running' if answer else 'stopped'
    known = facts(port, answer)
    if args.json:
        out = {'state': state, 'url': known['url'], 'schema': 2}
        if answer:
            out['pid'] = answer['pid']
        out.update({'port': port, 'host': '127.0.0.1', 'modules': known['modules'], 'pages': known['pages']})
        if known['socket']:
            out['walkr'] = {'socket': known['socket']}
        if remote:
            out['store_host'] = remote
        print(json.dumps(out))
        return 0
    print('state: ' + state)
    print('health: ' + (f'ok (pid {answer["pid"]})' if answer else f'no answer on 127.0.0.1:{port}'))
    print('url: ' + known['url'])
    print('root: ' + known['pages']['root'])
    if known['socket']:
        print(f'walkr: {known["pages"]["walkr"]} (live Walkr server: {known["socket"]})')
    if known['old']:
        print(OLD_SERVER_NOTE)
    if value is not None and remote is None:
        print('remote: the value in the configuration file is not a plain SSH destination')
    return 0


def cmd_walkr_url(args):
    """Print the private address of the Walkr page on the origin of this server: one line on standard output.

    `walkr-compare open` starts the live Walkr server when none runs and prints the address on the Walkr port. It
    runs with server_env(), so it uses ~/.human-review as the server does. That environment holds neither
    WALKR_SHEPRD_CONNECT nor HERDR_ENV, so the optional Sheprd link of Walkr stays off: Sheprd calls this command
    itself and must not get the address of the Walkr port."""
    port = port_of(config())
    env = server_env()
    program = shutil.which(walkr_front.PROGRAM, path=env.get('PATH', ''))
    if program is None:
        raise Stop(4, f'Walkr is not installed: the program {walkr_front.PROGRAM} is not on the PATH')
    answer = health(port)
    if not answer:
        raise Stop(3, f'the local server does not run on port {port}; start it with artifacts start')
    if facts(port, answer)['old']:
        # A server from before the update has no Walkr pass: the address would not work on its port.
        raise Stop(3, f'the local server on port {port} runs from before the update and has no Walkr pass; '
                      'run artifacts off, then artifacts start')
    words = [program, 'open'] + ([args.session] if args.session else [])
    try:
        done = subprocess.run(words, env=env, stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=WALKR_URL_WAIT, cwd=str(store_lib.state_dir()))
    except subprocess.TimeoutExpired:
        raise Stop(3, f'the live Walkr server gave no page address in {WALKR_URL_WAIT} s') from None
    except OSError as error:
        raise Stop(4, f'{walkr_front.PROGRAM} cannot run: {error.strerror}') from None
    why = walkr_front.mask(plain(done.stderr.decode('utf-8', 'replace'), 300))
    if done.returncode == 2:
        raise Stop(2, 'the session is unknown or the ID is not valid' + (f' ({why})' if why else ''))
    if done.returncode in (126, 127):
        # The program is a Node script: env exits 127 when node is not on the PATH.
        raise Stop(4, f'{walkr_front.PROGRAM} cannot run; is Node on the PATH?' + (f' ({why})' if why else ''))
    if done.returncode != 0:
        raise Stop(3, 'the live Walkr server did not answer' + (f' ({why})' if why else ''))
    lines = done.stdout.decode('utf-8', 'replace').split()
    address = urllib.parse.urlsplit(lines[-1] if lines else '')
    if (address.scheme != 'http' or address.query or not WALKR_PAGE.fullmatch(address.path)
            or address.fragment and not WALKR_SESSION.fullmatch(address.fragment)):
        raise Stop(3, f'{walkr_front.PROGRAM} open printed no page address')
    print(f'http://127.0.0.1:{port}{address.path}' + (f'#{address.fragment}' if address.fragment else ''))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog='artifacts', description=__doc__.split('\n')[0])
    parser.add_argument('--json', action='store_true', help='status: print one JSON object: state, url, pages, modules and more')
    parser.add_argument('--here', action='store_true',
                        help='use the store of this computer; ignore the key remote for this call')
    sub = parser.add_subparsers(dest='command', required=True)
    setup = sub.add_parser('setup', help='write the port into the configuration file; keep each other key')
    setup.add_argument('--port', type=int, help=f'the loopback port of the server (default {store_lib.DEFAULT_PORT})')
    where = setup.add_mutually_exclusive_group()
    where.add_argument('--remote', metavar='HOST',
                       help='an SSH destination: upload, list, delete and open use the store of HOST')
    where.add_argument('--local', action='store_true', help='remove the key remote: use the store of this computer')
    upload = sub.add_parser('upload', help='scan one .html or .md file and store it; print the view link')
    upload.add_argument('file', help='the file, or - for standard input with --name')
    upload.add_argument('--name', help='with -: the file name of standard input (only its last path part)')
    upload.add_argument('--size', type=int, metavar='BYTES',
                        help='with -: the byte count of the file; standard input of another size is refused')
    upload.add_argument('--sha256', metavar='HEX',
                        help='with -: the SHA-256 of the file; standard input with another hash is refused')
    upload.add_argument('--title')
    upload.add_argument('--repo', help='the repo name (default: the origin remote or the checkout of the directory)')
    upload.add_argument('--replace', metavar='SLUG',
                        help='store the file under this existing slug; the link, the created time, the title and '
                             'the repo stay')
    sub.add_parser('list', help='one line for each stored artifact, newest first: slug, title, expiry')
    opener = sub.add_parser('open', help='print the /artifacts address or the viewer URL; show it in Sheprd in Herdr')
    opener.add_argument('slug', nargs='?')
    delete = sub.add_parser('delete', help='delete the named artifacts from the store')
    delete.add_argument('slugs', nargs='+', metavar='SLUG')
    sub.add_parser('doctor', help='the store, the port, the server, the retention and the scanner')
    retention = sub.add_parser('retention', help='print the retention, or set it: a number of days or none')
    retention.add_argument('value', nargs='?')
    sub.add_parser('start', help='start the local server when none runs; the last line is the /artifacts address')
    sub.add_parser('off', aliases=['stop'], help='stop the local server of this user')
    sub.add_parser('status', help='running or stopped, the health and the page addresses')
    walkr_url = sub.add_parser('walkr-url', help='print the private address of the Walkr page on this server; '
                                                 'start the live Walkr server when none runs')
    walkr_url.add_argument('session', nargs='?', metavar='SESSION-ID')
    args = parser.parse_args(argv)
    commands = {'setup': cmd_setup, 'upload': cmd_upload, 'list': cmd_list, 'open': cmd_open, 'delete': cmd_delete,
                'doctor': cmd_doctor,
                'retention': cmd_retention, 'start': cmd_start, 'off': cmd_off, 'stop': cmd_off,
                'status': cmd_status, 'walkr-url': cmd_walkr_url}
    try:
        args.host = remote_of(config()) if args.command in REMOTE_COMMANDS and not args.here else None
        return commands[args.command](args)
    except Stop as error:
        print('artifacts: ' + str(error), file=sys.stderr)
        return error.code


if __name__ == '__main__':
    sys.exit(main())
