#!/usr/bin/env python3
"""artifacts: store an HTML or Markdown file on the artifact server of the user and print its view link.

Commands: setup, upload, list, open, doctor, and start, off (alias stop) and status for one local server. The
configuration file holds the origin and the path of the token file, and for a local server the clone and the port;
the token stays in the token file. The CLI talks only to the configured origin, follows no redirect and ignores
proxy variables. With no configuration, each command except setup, off and status exits 4 before any request.

Exit codes: 0 done, 2 refused input, 3 request or server failure, 4 no configuration, 5 the scan stopped the upload.
"""
import argparse
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import shlex
import re
import secrets
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

TYPES = {'.html': 'text/html', '.htm': 'text/html', '.md': 'text/markdown', '.markdown': 'text/markdown'}
MAX_BYTES = 10 * 1024 * 1024
TIMEOUT = 30
SCAN_TIMEOUT = 300
DEFAULT_PORT = 6790
HEALTH_WAIT = 30
STOP_WAIT = 10
STATUS_TIMEOUT = 5
# A test seam, not a setting: a command line (shlex form) that scans the files of its working directory.
SCAN_ENV = 'ARTIFACTS_SCAN_COMMAND'


class Stop(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def absolute_env(name):
    """An absolute path from the environment, or None: a relative value is ignored, as the XDG rule says."""
    value = os.environ.get(name) or ''
    return Path(value) if os.path.isabs(value) else None


def config_path():
    return (absolute_env('XDG_CONFIG_HOME') or Path.home() / '.config') / 'tenant-artifacts' / 'config.json'


def state_dir():
    return (absolute_env('XDG_STATE_HOME') or Path.home() / '.local/state') / 'tenant-artifacts'


def data_dir():
    return (absolute_env('XDG_DATA_HOME') or Path.home() / '.local/share') / 'tenant-artifacts' / 'data'


def load_config():
    path = config_path()
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        raise Stop(2, f'cannot read {path}: {type(error).__name__}') from None
    if not isinstance(data, dict):
        raise Stop(2, f'{path} does not hold a JSON object')
    return data


def write_config(data):
    path = config_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, scratch = tempfile.mkstemp(dir=path.parent, prefix='.config-')
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        os.fchmod(handle.fileno(), 0o600)
        handle.write(json.dumps(data, indent=2) + '\n')
    os.replace(scratch, path)


def check_origin(value):
    """The origin in normal form, or a Stop. https, or http only for a loopback host; no path, query or user."""
    parts = urllib.parse.urlsplit(value.strip())
    host = parts.hostname or ''
    if parts.scheme not in ('https', 'http') or not host or parts.username or parts.password \
            or parts.path not in ('', '/') or parts.query or parts.fragment:
        raise Stop(2, 'an origin is https://<host>[:port], or http://127.0.0.1:<port> on the same computer')
    try:
        parts.port
    except ValueError:
        raise Stop(2, 'the port of the origin is not valid') from None
    if parts.scheme == 'http':
        try:
            loopback = ipaddress.ip_address(host).is_loopback
        except ValueError:
            loopback = host == 'localhost'
        if not loopback:
            raise Stop(2, 'http is only for a loopback origin; use https')
    return parts.scheme + '://' + parts.netloc.lower()


def configured():
    data = load_config()
    if not data.get('origin') or not data.get('tokenFile'):
        raise Stop(4, 'no configuration; run: artifacts setup')
    return check_origin(data['origin']), str(data['tokenFile'])


def token_state(path):
    """(token or None, a state text without the token)."""
    try:
        info = os.stat(path)
    except OSError:
        return None, 'absent'
    mode = '%o' % stat.S_IMODE(info.st_mode)
    try:
        with open(path, encoding='utf-8') as handle:
            words = handle.read().split()
    except (OSError, UnicodeDecodeError):
        return None, f'exists, mode {mode}, not readable'
    if len(words) != 1:
        return None, f'exists, mode {mode}, does not hold one token'
    loose = ', readable by others' if info.st_mode & 0o077 else ''
    return words[0], f'exists, mode {mode}, one token{loose}'


def read_token(path):
    token, state = token_state(path)
    if token is None:
        raise Stop(2, f'the token file {path}: {state}')
    return token


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Follow no redirect: urllib would send the Authorization header to the new location."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect)


def request(origin, path, token=None, body=None, key=None, timeout=TIMEOUT):
    """The parsed JSON reply of one request to the origin. A 3xx, 4xx or 5xx reply is a Stop with code 3."""
    headers = {}
    if token is not None:
        headers['Authorization'] = 'Bearer ' + token
    if body is not None:
        headers['Content-Type'] = 'application/json'
        headers['Idempotency-Key'] = key
    req = urllib.request.Request(origin + path, data=body, headers=headers, method='POST' if body else 'GET')
    try:
        with OPENER.open(req, timeout=timeout) as reply:
            text = reply.read().decode('utf-8')
    except urllib.error.HTTPError as error:
        if 300 <= error.code < 400:
            raise Stop(3, f'the server answered HTTP {error.code}, a redirect; the CLI follows none') from None
        raise Stop(3, f'the server answered HTTP {error.code}') from None
    except (urllib.error.URLError, OSError) as error:
        raise Stop(3, f'no answer from {origin}: {type(error).__name__}') from None
    try:
        return json.loads(text) if text else {}
    except ValueError:
        raise Stop(3, 'the server answer is not JSON') from None


# ---------------------------------------------------------------------------
# The secret scan
# ---------------------------------------------------------------------------
def kit_scanner():
    """`<kit>/scripts/scan.sh --level warn tree` when the CLI runs from a kit tree, else None."""
    kit = Path(os.path.realpath(__file__)).parents[5]
    scan = kit / 'scripts' / 'scan.sh'
    if scan.is_file() and (kit / 'config' / 'manifest.json').is_file():
        return ['sh', str(scan), '--level', 'warn', 'tree']
    return None


def find_scanner():
    line = os.environ.get(SCAN_ENV)
    if line:
        print(f'warning: {SCAN_ENV} is set (a test seam); the kit scanner does not run', file=sys.stderr)
        return shlex.split(line)
    return kit_scanner()


def scan(command, path):
    """Run the scanner on a copy of the file in a new scratch Git repository. A finding or an error is a Stop."""
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env['GIT_CONFIG_NOSYSTEM'] = '1'
    work = tempfile.mkdtemp(prefix='artifacts-scan-')
    try:
        shutil.copyfile(path, os.path.join(work, path.name))
        try:
            subprocess.run(['git', 'init', '-q', work], env=env, check=True, capture_output=True, timeout=60)
            subprocess.run(['git', '-C', work, 'add', '--', path.name], env=env, check=True, capture_output=True,
                           timeout=60)
            done = subprocess.run(command, cwd=work, env=env, capture_output=True, text=True, timeout=SCAN_TIMEOUT)
        except (OSError, subprocess.SubprocessError) as error:
            raise Stop(5, f'scan: the scanner did not run ({type(error).__name__}); nothing uploaded') from None
        if done.returncode:
            report = (done.stdout + done.stderr).strip()
            if report:
                print(report, file=sys.stderr)
            # scripts/scan.sh: exit 1 is a finding; exit 2 is a usage or tool error, for example no Betterleaks binary.
            if done.returncode == 1:
                raise Stop(5, 'scan: the scanner reported a finding; nothing uploaded')
            raise Stop(5, f'scan: the scanner could not run (exit {done.returncode}); nothing uploaded')
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ---------------------------------------------------------------------------
# The commands
# ---------------------------------------------------------------------------
def ask(prompt, default=None):
    shown = f'{prompt} [{default}]: ' if default else f'{prompt}: '
    try:
        answer = input(shown).strip()
    except EOFError:
        raise Stop(2, 'cancelled: no answer (give the value as an option)') from None
    return answer or default or ''


def cmd_setup(args):
    data = load_config()
    saved = data.get('origin')
    if args.check and args.origin is None and args.token_file is None and args.clone is None:
        # Is a configuration saved? No question, no write, no request.
        if not saved or not data.get('tokenFile'):
            raise Stop(4, 'no configuration')
        print('origin: ' + check_origin(saved))
        return 0
    if args.check:
        args.yes = True
    if args.port is not None and args.clone is None:
        raise Stop(2, '--port needs --clone')
    if args.clone is not None:
        if args.origin is not None:
            raise Stop(2, 'give --clone or --origin, not both: the origin of a local server is http://127.0.0.1:<port>')
        clone = os.path.realpath(os.path.expanduser(args.clone))
        if not os.path.isfile(os.path.join(clone, 'server.mjs')):
            raise Stop(2, f'{clone} has no server.mjs: give the path of a clone of the artifact server')
        port = args.port if args.port is not None else data.get('port') or DEFAULT_PORT
        if not isinstance(port, int) or not 1 <= port <= 65535:
            raise Stop(2, 'the port is a number from 1 to 65535')
        origin = f'http://127.0.0.1:{port}'
        if args.token_file is None:
            args.token_file = data.get('tokenFile') if data.get('clone') else None
            args.token_file = args.token_file or str(config_path().parent / 'local-token')
    else:
        origin = args.origin
    if origin is None:
        if args.yes:
            raise Stop(2, 'setup --yes needs --origin or --clone')
        origin = ask('Origin of the artifact server (https://<host>[:port])', saved)
    origin = check_origin(origin)
    token_file = args.token_file
    if token_file is None:
        if args.yes:
            raise Stop(2, 'setup --yes needs --token-file')
        token_file = ask('Path of the token file', data.get('tokenFile'))
    if not token_file:
        raise Stop(2, 'the path of the token file is empty')
    token_file = os.path.abspath(os.path.expanduser(token_file))
    if saved and saved != origin and not args.replace_origin:
        if args.yes:
            raise Stop(2, f'the configuration has the origin {saved}; add --replace-origin to replace it')
        if ask(f'Replace the saved origin {saved}? [y/N]').lower() not in ('y', 'yes'):
            raise Stop(2, 'cancelled: the origin stays')
    if args.check:
        return 0
    data['origin'] = origin
    data['tokenFile'] = token_file
    if args.clone is not None:
        data['clone'] = clone
        data['port'] = port
    elif local_target(data) is None:
        # An origin that is not the local origin of the clone: no stale local server keys.
        data.pop('clone', None)
        data.pop('port', None)
    write_config(data)
    print('config: ' + str(config_path()))
    print('origin: ' + origin)
    if args.clone is not None:
        print('clone: ' + clone)
    print('token file: ' + token_file + ' (' + token_state(token_file)[1] + ')')
    return 0


def cmd_upload(args):
    origin, token_file = configured()
    path = Path(args.file)
    kind = TYPES.get(path.suffix.lower())
    if kind is None:
        raise Stop(2, 'the file must end in .html, .htm, .md or .markdown')
    try:
        raw = path.read_bytes()
    except OSError as error:
        raise Stop(2, f'cannot read {path}: {error.strerror}') from None
    if len(raw) > MAX_BYTES:
        raise Stop(2, 'the file is larger than 10 MiB')
    try:
        content = raw.decode('utf-8')
    except UnicodeDecodeError:
        raise Stop(2, 'the file is not UTF-8 text') from None
    command = find_scanner()
    if command is None:
        print('warning: no secret scanner (the CLI runs outside a kit tree); the file is not scanned', file=sys.stderr)
    else:
        scan(command, path)
    token = read_token(token_file)
    title = args.title or path.stem
    body = json.dumps({'content': content, 'contentType': kind, 'fileName': path.name, 'title': title}).encode()
    key = hashlib.sha256(path.name.encode() + b'\0' + raw).hexdigest()
    answer = request(origin, '/v1/artifacts', token=token, body=body, key=key)
    artifact = answer.get('artifact') if isinstance(answer, dict) else None
    if not isinstance(artifact, dict) or not artifact.get('slug'):
        raise Stop(3, 'the server answer has no artifact')
    # The edit token of the answer is neither printed nor kept.
    print('slug: ' + str(artifact['slug']))
    print('view: ' + str(answer.get('shareUrl') or origin + '/a/' + urllib.parse.quote(str(artifact['slug']))))
    print('expires: ' + str(artifact.get('expiresAt')))
    return 0


def cmd_list(args):
    origin, token_file = configured()
    token = read_token(token_file)
    cursor = None
    while True:
        path = '/v1/artifacts' + ('?cursor=' + urllib.parse.quote(cursor, safe='') if cursor else '')
        answer = request(origin, path, token=token)
        items = answer.get('artifacts') if isinstance(answer, dict) else None
        if not isinstance(items, list):
            raise Stop(3, 'the server answer has no artifact list')
        for item in items:
            artifact = item.get('artifact', item) if isinstance(item, dict) else {}
            print('\t'.join(str(artifact.get(key) or '') for key in ('slug', 'title', 'expiresAt')))
        cursor = answer.get('nextCursor')
        if not cursor:
            return 0


def sheprd_command():
    """The Sheprd command: `sheprd` on PATH, then ~/.local/bin/sheprd, then the old path of an old install; else None."""
    found = shutil.which('sheprd')
    if found:
        return found
    for path in (Path.home() / '.local/bin/sheprd', Path.home() / '.local/state/herdr/gpui/bin/herdr-gpui'):
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return None


def cmd_open(args):
    origin, _ = configured()
    url = origin + ('/a/' + urllib.parse.quote(args.slug, safe='') if args.slug else '/browse')
    print(url)
    sheprd = sheprd_command() if os.environ.get('HERDR_ENV') == '1' else None
    if sheprd:
        try:
            done = subprocess.run([sheprd, 'browser', 'open', url], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            print('warning: Sheprd did not open the page (' + type(error).__name__ + ')', file=sys.stderr)
            return 0
        if done.returncode:
            print('warning: Sheprd did not open the page (exit ' + str(done.returncode) + ')', file=sys.stderr)
    return 0


def cmd_doctor(args):
    origin, token_file = configured()
    print('origin: ' + origin)
    try:
        request(origin, '/healthz')
        health = 'ok'
    except Stop as error:
        health = str(error)
    print('health: ' + health)
    token, state = token_state(token_file)
    print('token file: ' + token_file + ' (' + state + ')')
    good = health == 'ok' and token is not None
    print('doctor: ' + ('PASS' if good else 'FAIL'))
    return 0 if good else 3


# ---------------------------------------------------------------------------
# The local server: start, off, status
# ---------------------------------------------------------------------------
def local_target(data):
    """(clone, port) when the configuration names a local server, else None."""
    clone, port = data.get('clone'), data.get('port')
    if clone and isinstance(port, int) and data.get('origin') == f'http://127.0.0.1:{port}':
        return str(clone), port
    return None


def server_script(clone):
    return os.path.realpath(os.path.join(clone, 'server.mjs'))


def script_argument(argv):
    """The script that a `node` command line runs: the first argument after argv[0] without a leading `-`.

    None when the base name of argv[0] is not exactly `node` or no such argument exists. When in doubt, no match:
    a missed server is safer than a signal to another program."""
    if not argv or os.path.basename(argv[0]) != 'node':
        return None
    return next((arg for arg in argv[1:] if not arg.startswith('-')), None)


def linux_processes(scripts):
    """{pid: argv} of the processes of this user in the PID namespace of the CLI that run one of `scripts`.

    The script argument is resolved against the working directory of the process, then compared by real path."""
    own_ns = os.readlink('/proc/self/ns/pid')
    found = {}
    for entry in os.listdir('/proc'):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            if os.stat(f'/proc/{entry}').st_uid != os.getuid() or os.readlink(f'/proc/{entry}/ns/pid') != own_ns:
                continue
            with open(f'/proc/{entry}/cmdline', 'rb') as handle:
                argv = [part.decode('utf-8', 'replace') for part in handle.read().split(b'\0') if part]
            arg = script_argument(argv)
            if arg is None:
                continue
            path = os.path.realpath(os.path.join(os.readlink(f'/proc/{entry}/cwd'), arg))
        except OSError:
            continue
        if path in scripts:
            found[int(entry)] = argv
    return found


def ps_script(command):
    """The real path of the script of a `node` command line in `ps` form, or None.

    `ps` loses the argument borders, so the script argument must be an absolute path, and exactly one existing file
    must start at it and end at a space or at the end of the line. A relative script argument does not match."""
    words = command.split(' ')
    index = next((i for i, word in enumerate(words) if i and word and not word.startswith('-')), None)
    if os.path.basename(words[0]) != 'node' or index is None or not words[index].startswith('/'):
        return None
    files = {os.path.realpath(path) for path in (' '.join(words[index:end]) for end in range(index + 1, len(words) + 1))
             if os.path.isfile(path)}
    return files.pop() if len(files) == 1 else None


def ps_processes(scripts):
    """The same as linux_processes, from `ps` (macOS has no PID namespace and no /proc/<pid>/cwd)."""
    done = subprocess.run(['ps', '-ww', '-x', '-U', str(os.getuid()), '-o', 'pid=', '-o', 'command='],
                          capture_output=True, text=True, timeout=30)
    found = {}
    for line in done.stdout.splitlines():
        pid, _, command = line.strip().partition(' ')
        command = command.strip()
        if pid.isdigit() and int(pid) != os.getpid() and command and ps_script(command) in scripts:
            found[int(pid)] = command.split()
    return found


def servers(scripts):
    scripts = sorted({script for script in scripts if script})
    if not scripts:
        return {}
    return linux_processes(scripts) if os.path.isdir('/proc/self/ns') else ps_processes(scripts)


def process_origin(pid):
    """ARTIFACT_ORIGIN of a server process on Linux, or None."""
    try:
        with open(f'/proc/{pid}/environ', 'rb') as handle:
            for item in handle.read().split(b'\0'):
                if item.startswith(b'ARTIFACT_ORIGIN='):
                    return check_origin(item.split(b'=', 1)[1].decode())
    except (OSError, UnicodeDecodeError, Stop):
        pass
    return None


def read_state():
    try:
        data = json.loads((state_dir() / 'server.json').read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) and isinstance(data.get('pid'), int) else {}


def lock():
    """An exclusive lock of the state directory for one start or off; it ends with the process."""
    state_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = open(state_dir() / 'lock', 'a')
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def running(data):
    """(pid, origin) of a local server of this user that runs (the state file, then the clone), or None."""
    state = read_state()
    found = servers([server_script(state['clone']) if state.get('clone') else None,
                     server_script(data['clone']) if data.get('clone') else None])
    if state.get('pid') in found:
        return state['pid'], state.get('origin') or process_origin(state['pid'])
    if found:
        pid = min(found)
        return pid, process_origin(pid)
    return None


def browse(origin):
    return origin + '/browse'


def node_minimum(clone):
    """The minimum Node version (a tuple) of the engines.node field of the clone, or ()."""
    try:
        engines = json.loads(Path(clone, 'package.json').read_text(encoding='utf-8')).get('engines') or {}
    except (OSError, ValueError, AttributeError):
        raise Stop(2, f'cannot read {clone}/package.json') from None
    match = re.search(r'(?:>=|\^|~|^)\s*v?(\d+(?:\.\d+){0,2})', str(engines.get('node') or ''))
    return tuple(int(part) for part in match.group(1).split('.')) if match else ()


def port_free(port):
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.settimeout(1)
        if probe.connect_ex(('127.0.0.1', port)) == 0:
            return False
    finally:
        probe.close()
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # as Node does; a TIME_WAIT port is free
        probe.bind(('127.0.0.1', port))
        return True
    except OSError:
        return False
    finally:
        probe.close()


def make_token(path):
    Path(path).parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        handle.write(secrets.token_urlsafe(32) + '\n')
    print('token file: ' + str(path) + ' (made, mode 600)')


def log_tail(log, token_file, count=20):
    try:
        lines = log.read_text(encoding='utf-8', errors='replace').splitlines()[-count:]
    except OSError:
        return ''
    token = token_state(token_file)[0]
    text = '\n'.join(lines)
    return text.replace(token, '<token>') if token else text


def stop_pid(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass


def cmd_start(args):
    data = load_config()
    if not data.get('origin'):
        raise Stop(4, 'no configuration; run: artifacts setup --clone PATH [--port N]')
    origin = check_origin(data['origin'])
    target = local_target(data)
    with lock():
        found = running(data)
        if found:
            pid, url = found
            print(f'a local server runs already (pid {pid}); start starts no second one')
            print(browse(url or origin))
            return 0
        if target is None:
            print('the origin is a remote server; start starts nothing')
            print(browse(origin))
            return 0
        clone, port = target
        clone = os.path.realpath(clone)
        if not os.path.isfile(os.path.join(clone, 'loopback-auth.mjs')):
            raise Stop(2, f'{clone} has no localhost mode (no loopback-auth.mjs): update the clone of the server')
        node = shutil.which('node')
        if node is None:
            raise Stop(2, 'no node command on the PATH')
        need = node_minimum(clone)
        try:
            have = tuple(int(x) for x in re.findall(r'\d+', subprocess.run(
                [node, '--version'], capture_output=True, text=True, timeout=30).stdout)[:3])
        except (OSError, subprocess.SubprocessError):
            raise Stop(2, 'node --version did not run') from None
        if have < need:
            raise Stop(2, 'Node ' + '.'.join(map(str, have)) + ' is below ' + '.'.join(map(str, need))
                       + ', the minimum of the server')
        if not os.path.isdir(os.path.join(clone, 'node_modules')):
            raise Stop(2, f'{clone} has no node_modules: run npm ci in the clone')
        if not port_free(port):
            raise Stop(2, f'port {port} is in use by another program; choose another with artifacts setup --port')
        token_file = str(data.get('tokenFile') or config_path().parent / 'local-token')
        if not os.path.exists(token_file):
            make_token(token_file)
        data_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
        data_dir().chmod(0o700)
        log = state_dir() / 'server.log'
        env = {name: os.environ[name] for name in ('PATH', 'HOME') if name in os.environ}
        env.update({'ARTIFACT_BROWSER_AUTH': 'loopback', 'ARTIFACT_BIND': '127.0.0.1', 'ARTIFACT_PORT': str(port),
                    'ARTIFACT_ORIGIN': origin, 'ARTIFACT_TOKEN_FILE': token_file,
                    'ARTIFACT_DATA_DIR': str(data_dir()), 'ARTIFACT_CONNECTORS_FILE': ''})
        fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as out:
            process = subprocess.Popen(['node', os.path.join(clone, 'server.mjs')], executable=node, cwd=clone,
                                       env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                                       start_new_session=True)
        deadline = time.monotonic() + HEALTH_WAIT
        while True:
            try:
                request(origin, '/healthz', timeout=2)
                break
            except Stop:
                ended = process.poll() is not None
                if ended or time.monotonic() > deadline:
                    # Signal only through the Popen object, and only while the child is not reaped: after poll()
                    # reaps it, its PID can belong to another program.
                    if process.poll() is None:
                        process.terminate()
                        try:
                            process.wait(timeout=STOP_WAIT)
                        except subprocess.TimeoutExpired:
                            process.kill()
                            process.wait()
                    tail = log_tail(log, token_file)
                    if tail:
                        print(tail, file=sys.stderr)
                    why = 'the server ended before a /healthz answer' if ended else \
                        f'the server gave no /healthz answer in {HEALTH_WAIT} s; it is stopped'
                    raise Stop(3, f'{why}. Log: {log}')
                time.sleep(0.25)
        (state_dir() / 'server.json').write_text(json.dumps(
            {'pid': process.pid, 'clone': clone, 'port': port, 'origin': origin}) + '\n', encoding='utf-8')
        print(f'started: pid {process.pid}, log {log}')
        print(browse(origin))
        return 0


def cmd_off(args):
    data = load_config()
    with lock():
        state = read_state()
        scripts = [server_script(state['clone']) if state.get('clone') else None,
                   server_script(data['clone']) if data.get('clone') else None]
        found = servers(scripts)
        for pid in found:
            stop_pid(pid)
        deadline = time.monotonic() + STOP_WAIT
        left = found
        while left and time.monotonic() < deadline:
            time.sleep(0.2)
            left = {pid: argv for pid, argv in servers(scripts).items() if pid in found}
        for pid in left:
            print(f'pid {pid} did not stop in {STOP_WAIT} s', file=sys.stderr)
        if state and state['pid'] not in servers(scripts):
            (state_dir() / 'server.json').unlink(missing_ok=True)
        stopped = len(found) - len(left)
        print(f'off: stopped {stopped} local server' + ('' if stopped == 1 else 's'))
        return 3 if left else 0


def cmd_status(args):
    data = load_config()
    if not data.get('origin'):
        state, url, health = 'unconfigured', None, 'no configuration'
    else:
        origin = check_origin(data['origin'])
        target = local_target(data)
        found = running(data)
        if found:
            origin = found[1] or origin
        if target is not None and not found:
            state, health = 'stopped', 'no local server runs'
        else:
            try:
                request(origin, '/healthz', timeout=STATUS_TIMEOUT)
                health = 'ok'
                state = 'running' if found else 'remote'
            except Stop as error:
                state, health = 'unreachable', str(error)
        url = browse(origin)
    if args.json:
        print(json.dumps({'state': state, 'url': url}))
        return 0
    print('state: ' + state)
    print('health: ' + health)
    if url:
        print('url: ' + url)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog='artifacts', description=__doc__.split('\n')[0])
    parser.add_argument('--json', action='store_true', help='status: print one JSON object {"state", "url"}')
    sub = parser.add_subparsers(dest='command', required=True)
    setup = sub.add_parser('setup', help='write the configuration file (origin, token file path)')
    setup.add_argument('--origin')
    setup.add_argument('--token-file')
    setup.add_argument('--clone', help='the clone of the artifact server for a local server on 127.0.0.1')
    setup.add_argument('--port', type=int, help=f'with --clone, the loopback port (default {DEFAULT_PORT})')
    setup.add_argument('--yes', action='store_true', help='ask nothing')
    setup.add_argument('--replace-origin', action='store_true', help='with --yes, replace a different saved origin')
    setup.add_argument('--check', action='store_true',
                       help='write nothing: check the given values as --yes does, or that a configuration is saved')
    upload = sub.add_parser('upload', help='scan and upload one .html or .md file; print the view link')
    upload.add_argument('file')
    upload.add_argument('--title')
    sub.add_parser('list', help='one line for each stored artifact: slug, title, expiry')
    opener = sub.add_parser('open', help='print the browse page URL or the artifact URL; show it in Sheprd in Herdr')
    opener.add_argument('slug', nargs='?')
    sub.add_parser('doctor', help='the origin, the server health and the token file state')
    sub.add_parser('start', help='start the local server of the configured clone; the last line is the browse URL')
    sub.add_parser('off', aliases=['stop'], help='stop each local server of this user that runs the configured clone')
    sub.add_parser('status', help='running, stopped, remote, unreachable or unconfigured; the URL and the health')
    args = parser.parse_args(argv)
    commands = {'setup': cmd_setup, 'upload': cmd_upload, 'list': cmd_list, 'open': cmd_open, 'doctor': cmd_doctor,
                'start': cmd_start, 'off': cmd_off, 'stop': cmd_off, 'status': cmd_status}
    try:
        return commands[args.command](args)
    except Stop as error:
        print('artifacts: ' + str(error), file=sys.stderr)
        return error.code


if __name__ == '__main__':
    sys.exit(main())
